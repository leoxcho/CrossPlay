+/* Local adaptation (2026-10-05) of Apple's LGPL-2.1-or-later
+ * macdrv_functions patch in apple/homebrew-apple. Upstream Wine 10 uses a
+ * PE/Unix split: Windows callbacks are passed in process_attach instead of
+ * being directly linked into this Unix module. Apple binaries are unchanged.
+ */
+struct gptk_macdrv_functions
+{
+    void (*init_display_devices)(BOOL);
+    struct macdrv_win_data *(*get_win_data)(HWND);
+    void (*release_win_data)(struct macdrv_win_data *);
+    macdrv_window (*get_cocoa_window)(HWND, BOOL);
+    macdrv_metal_device (*create_metal_device)(void);
+    void (*release_metal_device)(macdrv_metal_device);
+    macdrv_metal_view (*create_metal_view)(macdrv_view, macdrv_metal_device);
+    macdrv_metal_layer (*get_metal_layer)(macdrv_metal_view);
+    void (*release_metal_view)(macdrv_metal_view);
+    void (*on_main_thread)(dispatch_block_t);
+    UINT64 win32[14];
+};
+extern void OnMainThread(dispatch_block_t);
+static void gptk_init_display_devices(BOOL force)
+{
+    /* Wine 10 maintains displays through win32u, rather than the Wine 8
+     * driver registry path. Request its normal display refresh. */
+    if (force) NtUserCallNoParam(NtUserCallNoParam_DisplayModeChanged);
+}
+__attribute__((visibility("default")))
+struct gptk_macdrv_functions macdrv_functions = {
+    gptk_init_display_devices, get_win_data, release_win_data,
+    macdrv_get_cocoa_window, macdrv_create_metal_device,
+    macdrv_release_metal_device, macdrv_view_create_metal_view,
+    macdrv_view_get_metal_layer, macdrv_view_release_metal_view, OnMainThread,
+    {0}
+};
 
